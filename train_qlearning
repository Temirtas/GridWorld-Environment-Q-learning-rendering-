import numpy as np
import gymnasium as gym

import environment  # noqa: F401  (registers "gymnasium_env/GridWorld-v0")

SIZE = 5

# ---------------- hyperparameters ----------------
EPISODES = 5000
ALPHA = 0.1          # learning rate: how far each update moves the table
GAMMA = 0.95         # discount: how much future reward matters
EPS_START = 1.0      # start fully random (pure exploration)
EPS_END = 0.05       # always keep a little exploration
EPS_DECAY = 0.999    # multiply epsilon by this after every episode
LOG_EVERY = 500


def encode(obs, size=SIZE):
    """Turn {'agent': [x, y], 'target': [tx, ty]} into one table row index."""
    ax, ay = obs["agent"]
    tx, ty = obs["target"]
    return int(((ax * size + ay) * size + tx) * size + ty)


def train():
    env = gym.make("gymnasium_env/GridWorld-v0", size=SIZE)  # no rendering = fast
    n_states = SIZE ** 4          # agent position x target position
    n_actions = env.action_space.n
    Q = np.zeros((n_states, n_actions))  # the "cheat sheet", starts empty
    rng = np.random.default_rng(0)
    epsilon = EPS_START

    steps_log, success_log, ratio_log = [], [], []

    for ep in range(1, EPISODES + 1):
        obs, info = env.reset()
        s = encode(obs)
        start_dist = info["distance"]
        steps, done = 0, False

        while not done:
            # Epsilon-greedy: explore randomly sometimes, otherwise use the table
            if rng.random() < epsilon:
                a = env.action_space.sample()
            else:
                best = np.flatnonzero(Q[s] == Q[s].max())
                a = int(rng.choice(best))  # break ties randomly

            obs, reward, terminated, truncated, info = env.step(a)
            s2 = encode(obs)
            steps += 1

            # Q-learning update. If the episode truly ended, there is no future value.
            target = reward + (0 if terminated else GAMMA * Q[s2].max())
            Q[s, a] += ALPHA * (target - Q[s, a])

            s = s2
            done = terminated or truncated

        epsilon = max(EPS_END, epsilon * EPS_DECAY)

        steps_log.append(steps)
        success_log.append(terminated)
        ratio_log.append(steps / start_dist)

        if ep % LOG_EVERY == 0:
            sl = slice(-LOG_EVERY, None)
            print(
                f"Episode {ep:5d} | epsilon {epsilon:.2f} | "
                f"avg steps {np.mean(steps_log[sl]):6.1f} | "
                f"success {np.mean(success_log[sl]):6.1%} | "
                f"steps/optimal {np.mean(ratio_log[sl]):.2f}"
            )

    env.close()
    np.save("q_table.npy", Q)
    return Q


def watch(Q, episodes=5):
    """Run the trained agent greedily (no randomness) in the pygame window."""
    env = gym.make("gymnasium_env/GridWorld-v0", size=SIZE, render_mode="human")
    for ep in range(episodes):
        obs, info = env.reset()
        done, steps = False, 0
        while not done:
            a = int(np.argmax(Q[encode(obs)]))
            obs, reward, terminated, truncated, info = env.step(a)
            steps += 1
            done = terminated or truncated
        print(f"Demo episode {ep + 1}: reached target in {steps} steps")
    env.close()


if __name__ == "__main__":
    Q = train()
    watch(Q)